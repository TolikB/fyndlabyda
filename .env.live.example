# Live mode is intentionally inert until every interlock below is supplied.
APP_ENV=production
LOG_LEVEL=INFO
RUN_MODE=live
MARKET_DATA_MODE=live_public
EXECUTION_MODE=live
DATABASE_URL=postgresql+asyncpg://funding:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/funding
POSTGRES_USER=funding
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=funding
REDIS_URL=redis://redis:6379/0
CLICKHOUSE_USER=funding_analytics
CLICKHOUSE_PASSWORD=CHANGE_ME_CLICKHOUSE_PASSWORD
CANONICAL_EVENT_QUEUE_SIZE=50000
CANONICAL_EVENT_BATCH_SIZE=500
CANONICAL_EVENT_FLUSH_INTERVAL_SECONDS=0.10

# Enable only after reading ops/LIVE_TRADING_RUNBOOK.md.
LIVE_ARMED=true
LIVE_TRADING_CONFIRM=I_UNDERSTAND_THIS_SENDS_REAL_ORDERS
LIVE_AUTOTRADE=false
LIVE_SANDBOX=false
LIVE_VENUES=bybit,gate,okx,binance,hyperliquid,mexc,kucoin,htx
LIVE_ALLOWED_ASSETS=BTC,ETH,SOL
LIVE_ALLOWED_STRATEGIES=spot_perp,cross_exchange_funding,futures_basis
LIVE_RESERVE_ASSETS=USD,USDT,USDC
LIVE_CLIENT_ORDER_PREFIX=fa
LIVE_KILL_SWITCH_FILE=.runtime/LIVE_DISABLED
LIVE_DEFAULT_POSITION_SIZE_USD=100
LIVE_MAX_ORDER_NOTIONAL_USD=100
LIVE_MAX_TOTAL_NOTIONAL_USD=500
LIVE_MAX_ASSET_NOTIONAL_USD=250
LIVE_MAX_VENUE_NOTIONAL_USD=300
LIVE_MAX_STRATEGY_NOTIONAL_USD=300
LIVE_MAX_CORRELATED_NOTIONAL_USD=300
LIVE_MAX_OPEN_POSITIONS=2
LIVE_MAX_DAILY_LOSS_USD=50
LIVE_MAX_DRAWDOWN_PERCENT=0.02
LIVE_MAX_SLIPPAGE_PERCENT=0.0015
LIVE_MAX_HEDGE_DRIFT_PERCENT=0.0005
LIVE_MAX_SPOT_RESIDUAL_USD=0.25
LIVE_MIN_FREE_BALANCE_PERCENT=30
LIVE_MIN_EXPECTED_PROFIT_USD=0.10
LIVE_MIN_VENUE_EQUITY_USD=10
LIVE_MAX_ADVERSE_BASIS_PERCENT=0.005
LIVE_ORDER_TIMEOUT_SECONDS=20
LIVE_RECONCILIATION_INTERVAL_SECONDS=30
LIVE_LOOP_INTERVAL_SECONDS=10
LIVE_MAX_HOLD_SECONDS=32400
LIVE_EXIT_EDGE_MISS_CYCLES=2
LIVE_ENTRY_WINDOW_HOURS=2
LIVE_MIN_SETTLEMENT_COST_COVERAGE=2
LIVE_SETTLEMENT_GRACE_SECONDS=90
LIVE_MARKET_PERSIST_INTERVAL_SECONDS=60
LIVE_ACCOUNT_SNAPSHOT_INTERVAL_SECONDS=60
LIVE_LEVERAGE=1
LIVE_MARGIN_MODE=isolated
LIVE_REQUIRE_DEDICATED_ACCOUNTS=true
LIVE_LIQUIDATE_ON_PAUSE=true

