  "$id": "https://fyndlabyda.local/schemas/acceptance-window-seal-input-v1.json",
  "additionalProperties": false,
  "description": "Validated boundary input used to create an immutable window bundle.",
  "properties": {
    "created_at": {
      "format": "date-time",
      "pattern": "(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)$",
      "title": "Created At",
      "type": "string"
    },
    "deterministic_replay": {
      "$ref": "#/$defs/DeterministicReplayEvidence"
    },
    "document_kind": {
      "const": "acceptance-window-seal-input",
      "title": "Document Kind",
      "type": "string"
    },
    "failure_injections": {
      "items": {
        "$ref": "#/$defs/FailureInjectionEvidence"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Failure Injections",
      "type": "array"
    },
    "gate_id": {
      "$ref": "#/$defs/AcceptanceGate"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/AcceptanceObservationInput"
      },
      "maxItems": 100000,
      "minItems": 2,
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "window_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "title": "Window Id",
      "type": "string"
    }
  },
  "required": [
    "document_kind",
    "schema_version",
    "gate_id",
    "window_id",
    "created_at",
    "observations",
    "failure_injections",
    "deterministic_replay"
  ],
  "title": "AcceptanceWindowSealInputV1",
  "type": "object",
  "x-runtime-constraints": [
    "all date-time values require an explicit UTC offset and are normalized to UTC",
    "all sha256 digests are exactly 64 lowercase hexadecimal characters",
    "image digests use the sha256:<64 lowercase hexadecimal characters> form",
    "Git revisions are full 40-character lowercase hexadecimal SHAs",
    "venue collections are normalized, non-empty where required, and unique",
    "replay source_start is strictly earlier than source_end",
    "JSON objects reject duplicate keys, non-finite numbers, and nesting above 128 levels"
  ]
}
