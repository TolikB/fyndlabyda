# Strategy v2 experiment stack (docs/STRATEGY_V2.md): four paper series on PUBLIC data,
# beside the live candidate/baseline stack. No exchange API keys are used; the service
# refuses to start if variables that look like exchange credentials exist.

# These two lines make every plain `docker compose` in this directory address the v2
# project. Never remove them: docker-compose.yml alone names the live paper project.
COMPOSE_PROJECT_NAME=funding_arbitrage_paper_v2
COMPOSE_FILE=docker-compose.yml:docker-compose.paper-v2.yml

APP_ENV=paper_live_data
LOG_LEVEL=INFO
RUN_MODE=paper_test
MARKET_DATA_MODE=live_public
EXECUTION_MODE=paper

# Required: database password for this stack's own volume (not the live stack's).
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# The live stack listens on 8000.
APP_PORT=8001

ENABLED_VENUES=bybit,gate,okx,binance,hyperliquid
PAPER_SERIES_FILE=config/paper_series.v2.yaml

# Stage 1 - observe only (no positions): PAPER_AUTOTRADE=false
# Stage 2 - paper trading after preflight and observation: PAPER_AUTOTRADE=true
PAPER_AUTOTRADE=false
PAPER_LOOP_INTERVAL_SECONDS=15
PAPER_CONFIRMATION_SECONDS=60
PAPER_BOOK_DEPTH=50
PAPER_MAX_BOOK_AGE_SECONDS=10
PAPER_MAX_FILL_SLIPPAGE_PERCENT=0.5
# Four series share these per-cycle budgets (the live stack has two series and 6/6).
PAPER_BOOK_CANDIDATES_PER_CYCLE=8
PAPER_HISTORY_REQUESTS_PER_CYCLE=8
PAPER_FUNDING_GRACE_SECONDS=900
PAPER_SNAPSHOT_INTERVAL_SECONDS=60

SCANNER_EXPECTED_HOLDING_HOURS=24
MARKET_DATA_STALE_SECONDS=60
MARKET_FUNDING_STALE_SECONDS=900
MARKET_VENUE_TIMEOUT_SECONDS=25
# The forecast averages the last 24h of settlements: refresh history hourly, not 6-hourly.
MARKET_HISTORY_TTL_SECONDS=3600
MARKET_PERSIST_FUNDING_SECONDS=900
MARKET_PERSIST_TICKERS=false
MARKET_DATA_RETENTION_DAYS=30
OKX_FUNDING_SYMBOL_LIMIT=30

# Fees (VIP0), taker and maker; the quality-maker series pays maker on passive legs.
# A fee change after the start requires new series labels.
BYBIT_TAKER_FEE=0.00055
BYBIT_MAKER_FEE=0.0002
BYBIT_SPOT_TAKER_FEE=0.001
GATE_TAKER_FEE=0.0005
GATE_MAKER_FEE=0.0002
GATE_SPOT_TAKER_FEE=0.001
OKX_TAKER_FEE=0.0005
OKX_MAKER_FEE=0.0002
OKX_SPOT_TAKER_FEE=0.001
BINANCE_TAKER_FEE=0.0005
BINANCE_MAKER_FEE=0.0002
BINANCE_SPOT_TAKER_FEE=0.001
HYPERLIQUID_TAKER_FEE=0.00045
HYPERLIQUID_MAKER_FEE=0.00015

# Telegram stays off here so the live stack's chat keeps one bot voice; compare the
# series through the API (/analytics/series, /analytics/compare) or replay-rules.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEZONE=Europe/Kyiv
TELEGRAM_REPORT_HOUR=0
TELEGRAM_REPORT_MINUTE=5

GRAFANA_ADMIN_PASSWORD=
