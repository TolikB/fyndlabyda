# Copy to a release-specific file on Contabo and replace RELEASE before use.
# This file contains no secrets. Keep the existing paper project's .env separate.
APP_ENV_FILE=/opt/funding_arbitrage_paper/.env
PAPER_RUNTIME_ENV_FILE=/opt/funding_arbitrage_paper/releases/RELEASE/paper-runtime.env
APP_IMAGE=funding-arbitrage-paper:SHA7
RELEASE_COMMIT_SHA=REPLACE_WITH_EXACT_40_HEX_SHA
INTERNAL_TLS_SECRETS_DIR=/opt/funding_arbitrage_paper/secrets/internal
PAPER_EMPTY_EXCHANGE_SECRETS_DIR=/opt/funding_arbitrage_paper/secrets/empty
RUN_MODE=paper_test
TRADING_MODE=PAPER
MARKET_DATA_MODE=live_public
EXECUTION_MODE=paper
MARKET_DATA_STREAMS_ENABLED=true
PUBLIC_EVENT_ENRICHMENT_ENABLED=true
CANONICAL_HIGH_FREQUENCY_MARKET_EVENTS_ENABLED=true
CANONICAL_HIGH_FREQUENCY_MARKET_EVENT_MIN_INTERVAL_SECONDS=0
MULTI_REGIME_ENABLED=true
MULTI_REGIME_PAPER_EXECUTION_ENABLED=true
CLICKHOUSE_ENABLED=false
ACCEPTANCE_COLLECTOR_ENABLED=false
PAPER_INITIAL_BALANCE_USD=1000
PAPER_RESERVE_PERCENT=20
PAPER_MAX_FUNDING_CAPITAL_USD=100
PAPER_MINIMUM_FUNDING_RATE=0.0002
PAPER_VENUES=bybit,gate,okx,binance,hyperliquid,mexc,kucoin,htx
PAPER_LOOP_INTERVAL_SECONDS=15
PAPER_AUTO_INIT_DATABASE=false
PAPER_AUTOTRADE=false
PAPER_COMPARISON_ENABLED=false
PAPER_SIMULATION_VERSION=paper-preflight-RELEASE
PAPER_BASELINE_SIMULATION_VERSION=paper-baseline-RELEASE
TELEGRAM_ENABLED=false
