# Non-secret runtime settings for the all-strategy PAPER stack (docker-compose.v1paper.yml).
# Copy to /opt/funding_arbitrage_v1paper/runtime.env (mode 0600) and set the RELEASE values.
APP_IMAGE=funding-arbitrage-v1paper:SHA7
RELEASE_COMMIT_SHA=REPLACE_WITH_EXACT_40_HEX_SHA
APP_PORT=8002
# Must not overlap the other compose projects on the host.
CONTROL_PLANE_SUBNET=172.31.245.0/24

RUN_MODE=paper_test
TRADING_MODE=PAPER
MARKET_DATA_MODE=live_public
EXECUTION_MODE=paper

# Multi-regime runtime: directional breakout/sweep, lead-lag, dated basis, options
# volatility and passive market making, with the dynamic liquid-altcoin universe.
# It requires the complete canonical journal, which is never pruned: watch disk.
MARKET_DATA_STREAMS_ENABLED=true
PUBLIC_EVENT_ENRICHMENT_ENABLED=true
CANONICAL_HIGH_FREQUENCY_MARKET_EVENTS_ENABLED=true
CANONICAL_HIGH_FREQUENCY_MARKET_EVENT_MIN_INTERVAL_SECONDS=0
MULTI_REGIME_ENABLED=true
MULTI_REGIME_PAPER_EXECUTION_ENABLED=true
MULTI_REGIME_DYNAMIC_UNIVERSE_ENABLED=true
# Measured on the shared VM with these five venues: trades and book deltas of the
# multi-regime universe write 11.5-12.6 GB/day of journal; 10 dynamic assets and
# eight venues wrote 15 GB/day.
MULTI_REGIME_UNIVERSE_MAXIMUM_ASSETS=4
MULTI_REGIME_UNIVERSE_MAXIMUM_NEW_ASSETS=2
PUBLIC_EVENT_SYMBOL_LIMIT_PER_PROFILE=2
# One process journals every event before using it and tops out near 125
# events/s on this host; past that, books arrive tens of seconds late. The
# strategies trade perpetuals only, so spot trade streams are off, and only
# open-position and multi-regime books stream: discovery books come over REST.
PUBLIC_EVENT_ACCOUNTS=linear
PAPER_STREAM_DISCOVERY_BOOKS=false
PAPER_ORDERBOOK_SYMBOL_LIMIT=6
CANONICAL_EVENT_FLUSH_INTERVAL_SECONDS=0.01
# A failed journal writer or multi-regime runtime rejects every later publish, so
# the whole stack stops until a restart. Exit instead: the compose restart policy
# starts a fresh process that rebuilds state from the journal.
PAPER_EXIT_ON_PIPELINE_FAILURE=true
# Candles are polled; 15s keeps a closed bar within the 30s freshness window.
PUBLIC_EVENT_REST_INTERVAL_SECONDS=15
MULTI_REGIME_STALE_AFTER_SECONDS=30
# Assets are ranked per venue. 4 left almost no asset listed on two venues, so the
# scanner had nothing to pair; 400 subscribed ~4000 ticker streams, saturated the
# event loop, broke the Bybit keepalive and left every candidate without a book.
# 30 pairs across venues at ~85% of a core and a 7.5s cycle.
PAPER_MARKET_ASSET_LIMIT=30
PAPER_HISTORY_SYMBOL_LIMIT=5
OPTIONS_MAXIMUM_EXPIRIES=1
OPTIONS_STRIKES_PER_EXPIRY=2
CLICKHOUSE_ENABLED=false
ACCEPTANCE_COLLECTOR_ENABLED=false
# Martingale, grid and loss averaging stay off: their paper profit hides tail risk.

# Every venue adds trade and book streams to the journal; these five carry the
# funding pairs.
PAPER_VENUES=bybit,okx,binance,gate,hyperliquid
PAPER_INITIAL_BALANCE_USD=1000
PAPER_RESERVE_PERCENT=20
PAPER_MAX_FUNDING_CAPITAL_USD=100
PAPER_MINIMUM_FUNDING_RATE=0.0002
PAPER_LOOP_INTERVAL_SECONDS=15
PAPER_AUTO_INIT_DATABASE=false

# Funding legs hold through noise (opportunity/patient_exit.py); the baseline
# portfolio of the comparison leaves only at max hold.
PAPER_EXIT_POLICY=patient
PAPER_MIN_HOLD_SECONDS=86400
PAPER_MAX_HOLD_SECONDS=345600
PAPER_PATIENT_EXIT_EDGE_8H=-0.0005
PAPER_PATIENT_EXIT_CONFIRMATION_SECONDS=3600

# Stage 1: PAPER_AUTOTRADE=false until the feeds are ready.
# Stage 2: true, with fresh versions and an explicit UTC start.
PAPER_AUTOTRADE=false
# PAPER_AUTOTRADE_START_UTC=2026-10-09T12:00:00Z  (set together with PAPER_AUTOTRADE=true; empty is invalid)
PAPER_COMPARISON_ENABLED=true
PAPER_SIMULATION_VERSION=v1paper-RELEASE-candidate
PAPER_BASELINE_SIMULATION_VERSION=v1paper-RELEASE-baseline
TELEGRAM_ENABLED=false
