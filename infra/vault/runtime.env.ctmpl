{{- with secret "kv/data/funding/v1/runtime" -}}
DATABASE_URL={{ .Data.data.database_url | toJSON }}
POSTGRES_PASSWORD={{ .Data.data.postgres_password | toJSON }}
REDIS_PASSWORD={{ .Data.data.redis_password | toJSON }}
CLICKHOUSE_PASSWORD={{ .Data.data.clickhouse_password | toJSON }}
CONTROL_PLANE_JWT_SECRET={{ .Data.data.control_plane_jwt_secret | toJSON }}
CONTROL_PLANE_MTLS_CLIENT_FINGERPRINTS={{ .Data.data.control_plane_mtls_client_fingerprints | toJSON }}
LIVE_EXPECTED_EGRESS_IP={{ .Data.data.live_expected_egress_ip | toJSON }}
GRAFANA_ADMIN_PASSWORD={{ .Data.data.grafana_admin_password | toJSON }}
{{- end }}
{{- with secret "kv/data/funding/v1/exchanges" }}
BYBIT_API_KEY={{ .Data.data.bybit_api_key | toJSON }}
BYBIT_API_SECRET={{ .Data.data.bybit_api_secret | toJSON }}
GATE_API_KEY={{ .Data.data.gate_api_key | toJSON }}
GATE_API_SECRET={{ .Data.data.gate_api_secret | toJSON }}
OKX_API_KEY={{ .Data.data.okx_api_key | toJSON }}
OKX_API_SECRET={{ .Data.data.okx_api_secret | toJSON }}
OKX_API_PASSPHRASE={{ .Data.data.okx_api_passphrase | toJSON }}
BINANCE_API_KEY={{ .Data.data.binance_api_key | toJSON }}
BINANCE_API_SECRET={{ .Data.data.binance_api_secret | toJSON }}
HYPERLIQUID_WALLET_ADDRESS={{ .Data.data.hyperliquid_wallet_address | toJSON }}
HYPERLIQUID_PRIVATE_KEY={{ .Data.data.hyperliquid_private_key | toJSON }}
MEXC_API_KEY={{ .Data.data.mexc_api_key | toJSON }}
MEXC_API_SECRET={{ .Data.data.mexc_api_secret | toJSON }}
KUCOIN_API_KEY={{ .Data.data.kucoin_api_key | toJSON }}
KUCOIN_API_SECRET={{ .Data.data.kucoin_api_secret | toJSON }}
KUCOIN_API_PASSPHRASE={{ .Data.data.kucoin_api_passphrase | toJSON }}
HTX_API_KEY={{ .Data.data.htx_api_key | toJSON }}
HTX_API_SECRET={{ .Data.data.htx_api_secret | toJSON }}
{{- end }}