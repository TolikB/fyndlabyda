# Fully offline deterministic profile: mock venues, fast funding (every 2 minutes).
APP_ENV=paper_test
LOG_LEVEL=INFO
RUN_MODE=paper_test
MARKET_DATA_MODE=mock
EXECUTION_MODE=paper
POSTGRES_PASSWORD=mock-profile-password
APP_PORT=8000
ENABLED_VENUES=bybit,gate,okx,binance,hyperliquid
PAPER_SERIES_FILE=config/paper_series.mock.yaml
PAPER_AUTOTRADE=true
PAPER_LOOP_INTERVAL_SECONDS=5
PAPER_CONFIRMATION_SECONDS=10
PAPER_SNAPSHOT_INTERVAL_SECONDS=10
PAPER_FUNDING_GRACE_SECONDS=60
MOCK_FUNDING_INTERVAL_SECONDS=120
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TIMEZONE=Europe/Kyiv
