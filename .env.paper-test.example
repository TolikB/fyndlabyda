APP_ENV=paper_test
LOG_LEVEL=INFO
RUN_MODE=paper_test
TRADING_MODE=PAPER
MARKET_DATA_MODE=mock
EXECUTION_MODE=paper
DATABASE_URL=postgresql+asyncpg://funding:funding@postgres:5432/funding
POSTGRES_USER=funding
POSTGRES_PASSWORD=funding
POSTGRES_DB=funding
REDIS_URL=rediss://redis:6379/0
REDIS_USERNAME=funding
REDIS_PASSWORD=funding-redis-local-only-0123456789abcdef
INTERNAL_SERVICE_TLS_REQUIRED=true
INTERNAL_TLS_CA_FILE=/run/secrets/internal/ca.crt
INTERNAL_TLS_CLIENT_CERT_FILE=/run/secrets/internal/app-client.crt
INTERNAL_TLS_CLIENT_KEY_FILE=/run/secrets/internal/app-client.key
INTERNAL_TLS_SECRETS_DIR=./secrets/internal
CLICKHOUSE_ENABLED=false
CLICKHOUSE_URL=https://clickhouse:8443
CLICKHOUSE_DATABASE=funding_analytics
CLICKHOUSE_USER=funding_analytics
CLICKHOUSE_PASSWORD=funding_analytics_test
CLICKHOUSE_REQUEST_TIMEOUT_SECONDS=10
CLICKHOUSE_REPLICATION_BATCH_SIZE=500
CLICKHOUSE_REPLICATION_POLL_SECONDS=1
GRAFANA_ADMIN_USER=funding_admin
GRAFANA_ADMIN_PASSWORD=funding-grafana-paper-test-only-0123456789abcdef
CANONICAL_EVENT_QUEUE_SIZE=50000
CANONICAL_EVENT_BATCH_SIZE=500
CANONICAL_EVENT_FLUSH_INTERVAL_SECONDS=0.10
MULTI_REGIME_ENABLED=true
MULTI_REGIME_ASSETS=BTC,ETH
MULTI_REGIME_SOURCE_INTERVAL_SECONDS=60
MULTI_REGIME_STRATEGY_INTERVAL_SECONDS=900
MULTI_REGIME_REGIME_INTERVAL_SECONDS=3600
MULTI_REGIME_STALE_AFTER_SECONDS=5
MULTI_REGIME_RESTORE_HOURS=168
MULTI_REGIME_ESTIMATED_COST_BPS=5
MULTI_REGIME_PAPER_EXECUTION_ENABLED=true
MULTI_REGIME_PAPER_LATENCY_MS=100
MULTI_REGIME_PAPER_MAXIMUM_PARTICIPATION_RATE=0.10
MULTI_REGIME_PAPER_IMPACT_COEFFICIENT_BPS=10
# Mock profile has no fabricated option chain.
OPTIONS_MARKET_DATA_ENABLED=false
OPTIONS_REFRESH_SECONDS=5
OPTIONS_MAXIMUM_EXPIRIES=2
OPTIONS_STRIKES_PER_EXPIRY=3
PUBLIC_EVENT_SYMBOL_LIMIT_PER_PROFILE=3
PUBLIC_EVENT_REST_INTERVAL_SECONDS=60
PUBLIC_EVENT_RECONNECT_INITIAL_SECONDS=1
PUBLIC_EVENT_RECONNECT_MAX_SECONDS=30
PUBLIC_METADATA_REFRESH_SECONDS=3600
PAPER_INITIAL_BALANCE_USD=1000
PAPER_SIZE_GRID_USD=50,100,250,500,1000,2500,5000
PAPER_MAX_FUNDING_CAPITAL_USD=100
PAPER_MINIMUM_FUNDING_RATE=0.0002
PAPER_RESERVE_PERCENT=20
PAPER_MAX_SINGLE_OPPORTUNITY_PERCENT=20
PAPER_MAX_SINGLE_ASSET_PERCENT=30
PAPER_MAX_SINGLE_EXCHANGE_PERCENT=40
PAPER_MAX_SINGLE_STRATEGY_PERCENT=60
PAPER_MAX_CORRELATED_GROUP_PERCENT=50
PAPER_LEGGING_MOVE_PERCENT=0.0002
PAPER_CORRELATION_GROUPS=BTC,ETH,SOL;DOGE,SHIB,PEPE,WIF,BONK,FLOKI,TUT
PAPER_VENUES=bybit,gate,okx,binance,hyperliquid,mexc,kucoin,htx
PAPER_AUTOTRADE=true
# PAPER_AUTOTRADE_START_UTC=2026-08-14T08:40:00Z
PAPER_LOOP_INTERVAL_SECONDS=5
PAPER_CONFIRMATION_SECONDS=10
PAPER_MAX_HOLD_SECONDS=60
PAPER_POSITION_SIZE_USD=50
PAPER_MAX_OPEN_POSITIONS=8
PAPER_SETTLEMENT_INTERVAL_SECONDS=15
PAPER_AUTO_INIT_DATABASE=true
PAPER_SIMULATION_VERSION=v34-cost-gated-candidate
PAPER_STRATEGY_PROFILE=candidate
PAPER_COMPARISON_ENABLED=false
PAPER_BASELINE_SIMULATION_VERSION=v34-cost-gated-baseline
PAPER_EXIT_EDGE_MISS_CYCLES=2
PAPER_FUNDING_HORIZON_HOURS=24
PAPER_FUNDING_RECONCILIATION_WINDOW_SECONDS=7200
PAPER_FUNDING_RECONCILIATION_POLL_SECONDS=60
PAPER_FUNDING_RECONCILIATION_MAX_POST_DEADLINE_ATTEMPTS=5
PAPER_ENTRY_WINDOW_HOURS=2
PAPER_MIN_SETTLEMENT_COST_COVERAGE=2
PAPER_MAX_ADVERSE_BASIS_PERCENT=0.005
PAPER_HISTORY_REFRESH_SECONDS=3600
PAPER_ORDERBOOK_SYMBOL_LIMIT=10
PAPER_MARKET_ASSET_LIMIT=12
PAPER_HISTORY_SYMBOL_LIMIT=5
SCANNER_MINIMUM_NET_APR=0.10
SCANNER_MINIMUM_LIQUIDITY_SCORE=0
SCANNER_MAXIMUM_SLIPPAGE_PERCENT=0.0015
SCANNER_MAXIMUM_SPREAD_PERCENT=0.0020
SCANNER_MINIMUM_FUNDING_SAMPLES=0
SCANNER_MINIMUM_DURATION_SECONDS=10
SCANNER_ALLOW_SPOT_SHORT=false
SCANNER_BORROWING_COST_DAILY=0
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEZONE=Europe/Kyiv
TELEGRAM_REPORT_HOUR=0
TELEGRAM_REPORT_MINUTE=0
