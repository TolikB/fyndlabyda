APP_ENV=development
LOG_LEVEL=INFO
RUN_MODE=api
MARKET_DATA_MODE=live_public
EXECUTION_MODE=paper
DATABASE_URL=postgresql+asyncpg://funding:funding@postgres:5432/funding
REDIS_URL=redis://redis:6379/0
BYBIT_BASE_URL=https://api.bybit.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_CATEGORIES=linear,spot
GATE_BASE_URL=https://api.gateio.ws/api/v4
GATE_WS_URL=wss://fx-ws.gateio.ws/v4/ws/usdt
GATE_SETTLE=usdt
OKX_BASE_URL=https://www.okx.com
OKX_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_FUNDING_SYMBOL_LIMIT=30
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
BINANCE_WS_URL=wss://fstream.binance.com/ws
HYPERLIQUID_BASE_URL=https://api.hyperliquid.xyz
HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
REQUEST_TIMEOUT_SECONDS=15
RATE_LIMIT_REQUESTS_PER_SECOND=8
RATE_LIMIT_BURST=8
MARKET_DATA_STALE_SECONDS=30
PAPER_INITIAL_BALANCE_USD=15000
PAPER_RESERVE_PERCENT=20
PAPER_AUTOTRADE=false
PAPER_LOOP_INTERVAL_SECONDS=10
PAPER_CONFIRMATION_SECONDS=30
PAPER_MAX_HOLD_SECONDS=900
PAPER_POSITION_SIZE_USD=250
PAPER_MAX_OPEN_POSITIONS=10
PAPER_SETTLEMENT_INTERVAL_SECONDS=28800
PAPER_AUTO_INIT_DATABASE=false
PAPER_HISTORY_REFRESH_SECONDS=3600
PAPER_ORDERBOOK_SYMBOL_LIMIT=10
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEZONE=Europe/Kyiv
TELEGRAM_REPORT_HOUR=0
TELEGRAM_REPORT_MINUTE=0
PAPER_VENUES=bybit,gate,okx,binance,hyperliquid
SCANNER_MINIMUM_NET_APR=0.10
SCANNER_MINIMUM_LIQUIDITY_SCORE=70
SCANNER_MAXIMUM_SLIPPAGE_PERCENT=0.15
SCANNER_MAXIMUM_SPREAD_PERCENT=0.20
SCANNER_MINIMUM_FUNDING_SAMPLES=20
SCANNER_MINIMUM_DURATION_SECONDS=30
BYBIT_MAKER_FEE=0.00020
BYBIT_TAKER_FEE=0.00055
GATE_MAKER_FEE=0.00015
GATE_TAKER_FEE=0.00050
OKX_MAKER_FEE=0.00020
OKX_TAKER_FEE=0.00050
BINANCE_MAKER_FEE=0.00020
BINANCE_TAKER_FEE=0.00040
HYPERLIQUID_MAKER_FEE=0.00015
HYPERLIQUID_TAKER_FEE=0.00035
