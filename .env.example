RATE_LIMIT_BURST=8
MARKET_DATA_STALE_SECONDS=30
ORDERBOOK_STREAM_STALE_SECONDS=120
FUNDING_SNAPSHOT_STALE_SECONDS=180
# Disabled by default. Acceptance runs use a fresh dedicated database namespace,
# the root-owned /run/funding-arbitrage/release-identity.json measurement, and a
# service-owned durable journal directory prepared by the operator.
ACCEPTANCE_COLLECTOR_ENABLED=false
ACCEPTANCE_WINDOW_ID=
ACCEPTANCE_JOURNAL_PATH=
ACCEPTANCE_SAMPLE_INTERVAL_SECONDS=240
PAPER_INITIAL_BALANCE_USD=1000
PAPER_SIZE_GRID_USD=50,100,250,500,1000,2500,5000
PAPER_MAX_FUNDING_CAPITAL_USD=100
PAPER_MINIMUM_FUNDING_RATE=0.0002
PAPER_RESERVE_PERCENT=20
PAPER_MAX_SINGLE_OPPORTUNITY_PERCENT=20
PAPER_MAX_SINGLE_ASSET_PERCENT=30
PAPER_MAX_SINGLE_EXCHANGE_PERCENT=40
PAPER_MAX_SINGLE_STRATEGY_PERCENT=60
PAPER_MAX_CORRELATED_GROUP_PERCENT=50
PAPER_LEGGING_MOVE_PERCENT=0.0002
PAPER_CORRELATION_GROUPS=BTC,ETH,SOL;DOGE,SHIB,PEPE,WIF,BONK,FLOKI,TUT
PAPER_AUTOTRADE=false
# PAPER_AUTOTRADE_START_UTC=2026-08-14T08:40:00Z
PAPER_LOOP_INTERVAL_SECONDS=10
PAPER_CONFIRMATION_SECONDS=30
PAPER_MAX_HOLD_SECONDS=900
PAPER_POSITION_SIZE_USD=50
PAPER_MAX_OPEN_POSITIONS=8
PAPER_SETTLEMENT_INTERVAL_SECONDS=28800
PAPER_AUTO_INIT_DATABASE=false
PAPER_HISTORY_REFRESH_SECONDS=3600
PAPER_ORDERBOOK_SYMBOL_LIMIT=10
PAPER_MARKET_ASSET_LIMIT=12
PAPER_MARKET_PERSIST_INTERVAL_SECONDS=300
PAPER_SIMULATION_VERSION=v34-cost-gated-candidate
PAPER_STRATEGY_PROFILE=candidate
PAPER_COMPARISON_ENABLED=false
PAPER_BASELINE_SIMULATION_VERSION=v34-cost-gated-baseline
PAPER_EXIT_EDGE_MISS_CYCLES=2
PAPER_FUNDING_HORIZON_HOURS=24
PAPER_FUNDING_RECONCILIATION_WINDOW_SECONDS=7200
PAPER_FUNDING_RECONCILIATION_POLL_SECONDS=60
PAPER_FUNDING_RECONCILIATION_MAX_POST_DEADLINE_ATTEMPTS=5
PAPER_ENTRY_WINDOW_HOURS=2
PAPER_MIN_SETTLEMENT_COST_COVERAGE=2
PAPER_MAX_ADVERSE_BASIS_PERCENT=0.005
BACKTEST_FILL_MODEL_ENABLED=true
BACKTEST_ORDER_LATENCY_MS=50
BACKTEST_CANCEL_LATENCY_MS=50
BACKTEST_MAXIMUM_PARTICIPATION_RATE=0.10
BACKTEST_PASSIVE_FILL_RATIO=0.50
BACKTEST_IMPACT_COEFFICIENT_BPS=10
PAPER_HISTORY_SYMBOL_LIMIT=5
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alertmanager reads these values from root-owned files; never commit their contents.
ALERTMANAGER_TELEGRAM_BOT_TOKEN_FILE=./secrets/telegram-bot-token
ALERTMANAGER_TELEGRAM_CHAT_ID_FILE=./secrets/telegram-chat-id
GRAFANA_ADMIN_USER=funding_admin
GRAFANA_ADMIN_PASSWORD=
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_TIMEZONE=Europe/Kyiv
TELEGRAM_REPORT_HOUR=0
TELEGRAM_REPORT_MINUTE=0
PAPER_VENUES=bybit,gate,okx,binance,hyperliquid,mexc,kucoin,htx
SCANNER_MINIMUM_NET_APR=0.10
SCANNER_MINIMUM_LIQUIDITY_SCORE=70
SCANNER_MAXIMUM_SLIPPAGE_PERCENT=0.0015
SCANNER_MAXIMUM_SPREAD_PERCENT=0.0020
SCANNER_MINIMUM_FUNDING_SAMPLES=20
SCANNER_MINIMUM_DURATION_SECONDS=30
SCANNER_ALLOW_SPOT_SHORT=false
SCANNER_BORROWING_COST_DAILY=0
BYBIT_MAKER_FEE=0.00020
BYBIT_TAKER_FEE=0.00055
BYBIT_OPTION_MAKER_FEE=0.00020
BYBIT_OPTION_TAKER_FEE=0.00030
BYBIT_OPTION_FEE_CAP_RATE=0.07
GATE_MAKER_FEE=0.00015
GATE_TAKER_FEE=0.00050
OKX_MAKER_FEE=0.00020
OKX_TAKER_FEE=0.00050
OKX_OPTION_MAKER_FEE=0.00020
OKX_OPTION_TAKER_FEE=0.00030
OKX_OPTION_FEE_CAP_RATE=0.07
BINANCE_MAKER_FEE=0.00020
BINANCE_TAKER_FEE=0.00040
HYPERLIQUID_MAKER_FEE=0.00015
HYPERLIQUID_TAKER_FEE=0.00035
MEXC_MAKER_FEE=0.00060
MEXC_TAKER_FEE=0.00080
KUCOIN_MAKER_FEE=0.00100
KUCOIN_TAKER_FEE=0.00100
HTX_MAKER_FEE=0.00200
HTX_TAKER_FEE=0.00200

# --- Guarded capability switches ---------------------------------------------
# Capabilities the specification marks financially dangerous need TWO
# independent operator decisions: the *_ENABLED flag below, and the exact
# canonical name listed in DANGEROUS_CAPABILITY_AUTHORIZATION. Leaving the
# authorization empty keeps every one of them fail-closed.
# Valid names: automated_withdrawals, dex_execution, grid_averaging,
# live_llm_decisions, live_rl_decisions, loss_averaging, martingale,
# mev_execution
DANGEROUS_CAPABILITY_AUTHORIZATION=

# Exchange-side reduce-only protective stops. Required in live modes.
PROTECTIVE_STOPS_ENABLED=true
PROTECTIVE_STOP_RECONCILE_INTERVAL_SECONDS=30
PROTECTIVE_STOP_MAXIMUM_UNKNOWN_SECONDS=120
PROTECTIVE_STOP_JOURNAL_PATH=.runtime/protective-stops.jsonl

# Smart order routing across venues.
SMART_ORDER_ROUTER_ENABLED=true
SMART_ORDER_ROUTER_MAXIMUM_CHILD_ORDERS=5
SMART_ORDER_ROUTER_MAXIMUM_PARTICIPATION_RATE=0.10

# Venue and portfolio margin simulation.
PORTFOLIO_MARGIN_SIMULATION_ENABLED=true

# Native low-latency sidecar. Needs the C gateway from native/low_latency.
NATIVE_LOW_LATENCY_ENABLED=false
NATIVE_LOW_LATENCY_HOST=
NATIVE_LOW_LATENCY_PORT=0
NATIVE_LOW_LATENCY_TIMEOUT_MS=5
NATIVE_LOW_LATENCY_P99_BUDGET_MS=10

# Research-only position-scaling strategies. Dangerous; disabled by default.
MARTINGALE_RESEARCH_ENABLED=false
GRID_RESEARCH_ENABLED=false
LOSS_AVERAGING_RESEARCH_ENABLED=false

# On-chain execution. Dangerous; disabled by default. Private key material is
# referenced indirectly and is never read, generated, or stored by the app.
DEX_EXECUTION_ENABLED=false
DEX_CHAIN_ID=0
DEX_RPC_URL=
DEX_JOURNAL_PATH=
# Reference only. The app never reads, generates, or stores key material.
DEX_SIGNER_REFERENCE=
DEX_REQUIRED_CONFIRMATIONS=12
DEX_MAXIMUM_SLIPPAGE_BPS=50
DEX_MAXIMUM_FEE_PER_GAS_GWEI=60
DEX_MAXIMUM_PRIORITY_FEE_GWEI=3
DEX_MAXIMUM_GAS_COST_WEI=20000000000000000
MEV_EXECUTION_ENABLED=false
MEV_RELAY_URL=
MEV_JOURNAL_PATH=
MEV_PRIVATE_RELAY_IDS=
MEV_MINIMUM_EXPECTED_PROFIT_USDT=25
MEV_MAXIMUM_LOSS_USDT=50
MEV_MAXIMUM_CAPITAL_AT_RISK_USDT=500
MEV_MAXIMUM_GAS_COST_USDT=50
MEV_MAXIMUM_BUILDER_PAYMENT_USDT=25
MEV_MAXIMUM_SIMULATION_DISPERSION_USDT=5

# Automated withdrawals. Dangerous; disabled by default.
WITHDRAWALS_ENABLED=false
WITHDRAWAL_JOURNAL_PATH=
# id:asset:network:address:venue1|venue2:max_amount, comma separated.
WITHDRAWAL_DESTINATION_ALLOWLIST=
WITHDRAWAL_MAXIMUM_SINGLE_USDT=1000
WITHDRAWAL_MAXIMUM_DAILY_USDT=5000
WITHDRAWAL_MAXIMUM_FEE_USDT=25
WITHDRAWAL_MINIMUM_CONFIRMATIONS=12

# Advisory LLM decision support. Dangerous in live modes; disabled by default
# and never granted execution authority.
DECISION_SUPPORT_LLM_ENABLED=false
DECISION_SUPPORT_LLM_BASE_URL=https://api.anthropic.com
DECISION_SUPPORT_LLM_MODEL=claude-sonnet-5
DECISION_SUPPORT_LLM_API_KEY=
DECISION_SUPPORT_LLM_TIMEOUT_SECONDS=5
DECISION_SUPPORT_LLM_MAXIMUM_OUTPUT_TOKENS=512
DECISION_SUPPORT_LLM_DAILY_BUDGET_USD=0
